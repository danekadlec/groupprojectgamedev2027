Caveman myCaveman;
ArrayList<Dinosaur> dinosaurs;
ArrayList<PowerUp> powerups;

void setup() {
  size(800, 600);
  myCaveman = new Caveman(width / 2, height - 100);
  dinosaurs = new ArrayList<Dinosaur>();
  powerups = new ArrayList<PowerUp>();
}

void draw() {
  background(220);
  myCaveman.move();
  myCaveman.display();
}

void keyPressed() {
  if (key == 'a' || key == 'A' || keyCode == LEFT) {
    myCaveman.moveLeft = true;
  }
  if (key == 'd' || key == 'D' || keyCode == RIGHT) {
    myCaveman.moveRight = true;
  }
  if (key == 'w' || key == 'W' || keyCode == UP) {
    myCaveman.jump();
  }
}

void keyReleased() {
  if (key == 'a' || key == 'A' || keyCode == LEFT) {
    myCaveman.moveLeft = false;
  }
  if (key == 'd' || key == 'D' || keyCode == RIGHT) {
    myCaveman.moveRight = false;
  }
}
